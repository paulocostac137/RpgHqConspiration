<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/imagemQuadroResultado"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#1E1E1E"
            android:contentDescription="Quadro gerado do GIF"
            android:scaleType="fitCenter" />

        <com.example.rpghqconspiration.MarcadoresBarraView
            android:id="@+id/marcadoresBarraQuadros"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_margin="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/botaoVoltarResultado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="VOLTAR"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/campoTextoImagem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="#99000000"
                    android:hint="Texto..."
                    android:imeOptions="actionDone"
                    android:inputType="textCapSentences"
                    android:maxLength="100"
                    android:paddingStart="8dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="10dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#BDBDBD"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/botaoFinalizar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="FINALIZAR"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical|start"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/seletorControleResultado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:dropDownWidth="wrap_content"
                    android:contentDescription="Selecionar configuração de controle" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/textoContadorQuadros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="56dp"
            android:layout_marginEnd="8dp"
            android:background="#99000000"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/controlesMarcadoresResultado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:orientation="vertical">

            <Button
                android:id="@+id/botaoGo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="Go"
                android:textSize="12sp" />

            <Button
                android:id="@+id/botaoOn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minWidth="0dp"
                android:text="On"
                android:textSize="12sp" />

            <Button
                android:id="@+id/botaoOut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minWidth="0dp"
                android:text="Out"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/controlesNavegacaoResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <SeekBar
                android:id="@+id/barraQuadros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="Navegar pelos quadros gerados" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/botaoQuadroAnterior"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="←"
                    android:textSize="20sp" />

                <Button
                    android:id="@+id/botaoPlayQuadros"
                    android:layout_width="66dp"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="▶"
                    android:textSize="16sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/botaoVer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:minWidth="0dp"
                    android:text="Ver"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/botaoProximoQuadro"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="→"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>

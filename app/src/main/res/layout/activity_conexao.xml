<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    android:id="@+id/layoutConexao"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RpgHqConspiration"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escolha como deseja utilizar o aplicativo"
        android:textColor="#CCCCCC"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <EditText
        android:id="@+id/campoCodigoPar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Digite o ID do par"
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA"
        android:inputType="text"
        android:maxLength="32"
        android:singleLine="true"
        android:padding="14dp"
        android:backgroundTint="#FFFFFF"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp">

            <Button
                android:id="@+id/botaoConectar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:minWidth="0dp"
                android:text="CONECTAR"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/botaoUsarSemConexao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:minWidth="0dp"
                android:text="SEM CONEXÃO"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/botaoCriar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:text="CRIAR"
                android:textSize="12sp"/>
        </LinearLayout>

    <TextView
        android:id="@+id/statusConexao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Escolha uma das opções."
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="20dp"/>

    </LinearLayout>

    <ScrollView
        android:id="@+id/statusConexaoAtivo"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="top"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="#121212"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false"
        android:fillViewport="true"
        android:elevation="16dp">

        <TextView
            android:id="@+id/textoStatusConexaoAtivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="top|center_horizontal"/>
    </ScrollView>

</FrameLayout>
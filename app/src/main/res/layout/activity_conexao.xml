<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RpgHqConspiration"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tituloModo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escolha como deseja utilizar o aplicativo"
        android:textColor="#CCCCCC"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <EditText
        android:id="@+id/campoCodigoPar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Digite o ID do par"
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA"
        android:inputType="text"
        android:maxLength="32"
        android:singleLine="true"
        android:padding="14dp"
        android:backgroundTint="#FFFFFF"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/controlesConexao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <Button
            android:id="@+id/botaoConectar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CONECTAR"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OU"
            android:textColor="#AAAAAA"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/botaoUsarSemConexao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="USAR SEM CONEXÃO"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/statusConexao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_gravity="center"
        android:visibility="gone"/>
    </FrameLayout>

    <TextView
        android:id="@+id/statusInicial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Escolha uma das opções."
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="20dp"/>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp"
    android:background="#171717">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="RpgHqConspiration"
        android:textColor="#FFFFFF"
        android:textSize="25sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="8dp"/>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Carregando..."
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:gravity="center"
        android:padding="6dp"/>

    <FrameLayout
        android:id="@+id/areaGif"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <ImageView
            android:id="@+id/imagemGif"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="GIF principal"/>

        <TextView
            android:id="@+id/textoPlanilha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center"
            android:padding="16dp"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:maxLines="5"
            android:ellipsize="end"
            android:visibility="gone"
            android:elevation="10dp"/>

        <TextView
            android:id="@+id/controleEsquerdo"
            android:layout_width="48dp"
            android:layout_height="100dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="8dp"
            android:background="#CC222222"
            android:gravity="center"
            android:text="↕"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:elevation="8dp"/>

        <TextView
            android:id="@+id/controleDireito"
            android:layout_width="48dp"
            android:layout_height="100dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="8dp"
            android:background="#CC222222"
            android:gravity="center"
            android:text="↕"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:elevation="8dp"/>

    </FrameLayout>

</LinearLayout>
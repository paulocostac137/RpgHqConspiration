<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp"
    android:background="#171717">

    <!-- TÍTULO -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="RpgHqConspiration"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="start|top"
        android:padding="8dp"/>

    <!-- ÁREA CENTRAL DOS GIFS E CONTROLES LATERAIS -->
    <LinearLayout
        android:id="@+id/linhaControles"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:background="#000000">

        <!-- CONTROLE LATERAL ESQUERDO -->

        <FrameLayout
            android:id="@+id/containerControleEsquerdo"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="12dp">

            <View
                android:id="@+id/sombraInferiorEsquerda"
                android:layout_width="48dp"
                android:layout_height="5dp"
                android:layout_gravity="bottom"
                android:elevation="7dp"/>

            <TextView
                android:id="@+id/controleEsquerdo"
                android:layout_width="48dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:background="#CC222222"
                android:gravity="center"
                android:text="↕"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold"
                android:elevation="8dp"/>

        </FrameLayout>

        <!-- ÁREA DA IMAGEM CENTRAL -->

        <FrameLayout
            android:id="@+id/areaGif"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:elevation="0dp"
            android:background="#000000"
            android:gravity="center">

            <!-- GIF PRINCIPAL CENTRALIZADO -->

            <ImageView
                android:id="@+id/imagemGif"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="GIF principal"
                android:scaleType="fitCenter"/>

            <!-- STATUS SOBRE A IMAGEM -->

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="#CC222222"
                android:elevation="20dp"
                android:gravity="center"
                android:padding="12dp"
                android:text="Carregando GIFs..."
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <!-- TEXTO SOBRE O GIF -->

            <TextView
                android:id="@+id/textoPlanilha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:gravity="center"
                android:padding="16dp"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:maxLines="5"
                android:ellipsize="end"
                android:visibility="gone"
                android:elevation="10dp"/>

            <TextView
                android:id="@+id/indicadorFrame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="#CC222222"
                android:elevation="20dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:padding="8dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:visibility="gone"/>

        </FrameLayout>

        <!-- CONTROLE LATERAL DIREITO -->

        <FrameLayout
            android:id="@+id/containerControleDireito"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="12dp">

            <View
                android:id="@+id/sombraInferiorDireita"
                android:layout_width="48dp"
                android:layout_height="5dp"
                android:layout_gravity="bottom"
                android:elevation="7dp"/>

            <TextView
                android:id="@+id/controleDireito"
                android:layout_width="48dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:background="#CC222222"
                android:gravity="center"
                android:text="↕"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold"
                android:elevation="8dp"/>

        </FrameLayout>

    </LinearLayout>

</LinearLayout>